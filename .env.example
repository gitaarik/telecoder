# ═══════════════════════════════════════════════════════════════
# TeleCoder Configuration
# ═══════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Comma-separated Telegram user IDs allowed to use the bot
# Get yours by messaging @userinfobot on Telegram
ALLOWED_USER_IDS=123456789

# ── Sharing the bot ───────────────────────────────────────────
# Everything below is for a bot you share with other people. A solo bot needs
# none of it and behaves exactly the same whether or not you read this section.
#
# ADMIN_USER_IDS is the subset of ALLOWED_USER_IDS that may approve permission
# prompts and run bot-lifecycle commands (/update, /restartbot, /rebuildbot)
# and transport ones (/method, /provider, /ccr). Everyone else is a "guest":
# they can use the agent normally, but guarded commands wait on an admin.
# Unset = every allowed user is an admin. Admins must also be in
# ALLOWED_USER_IDS — the auth check runs first and would turn them away, so the
# bot refuses to start rather than leave an admin who can never act.
# ADMIN_USER_IDS=123456789

# Comma-separated group/supergroup chat IDs the bot is used in.
# ALLOWED_GROUP_IDS=-1001234567890

# Confine guests to those groups, so they can't take the bot into a private
# chat where you can't see what they're asking it. Admins can still DM it.
# RESTRICT_TO_GROUPS=false

# The permission gate: matching a dangerous Bash pattern (rm -rf, sudo,
# git push --force, DROP TABLE, terraform destroy, ...) pauses the tool call
# and posts an approval prompt that only an admin can answer. With guests
# present it turns itself on; set it explicitly to override in either
# direction.
# TELECODER_PERMISSION_PROMPTS=1

# How long a prompt (or a held message) waits for an admin before it is refused.
# PERMISSION_PROMPT_TIMEOUT_MINUTES=10

# Scope guard: also prompt when a tool call names a path outside the shared
# projects, or a credential path anywhere (~/.ssh, ~/.aws, a .env outside the
# roots, the bot's own state). System paths and language toolchains stay
# readable without prompting, so ordinary work is unaffected.
# 'auto' follows the permission gate. 'on' / 'off' force it.
# SCOPE_GUARD=auto

# Extra directories the scope guard counts as in-bounds, on top of
# WORKSPACE_DIR and the temp dir. Comma-separated absolute paths.
# SCOPE_ALLOWED_PATHS=/srv/data,/opt/shared

# Charter judge: before a guest's message reaches Claude, a Haiku side-call
# reads it against a plain-language charter and holds anything out of bounds
# for an admin. Catches what the scope guard cannot — "open a tunnel to this
# box", "email me the projects folder" — because neither names a path.
# Adds ~5s to a guest's turn; conversational filler is skipped. Fails open.
# 'auto' turns it on once the bot has guests.
# CHARTER_JUDGE=auto

# The charter the judge reads. Defaults to CHARTER.md in WORKSPACE_DIR when
# that file exists, and to a generated one naming the allowed roots otherwise.
# CHARTER_FILE=/srv/shared/CHARTER.md

# The gate is a PreToolUse hook on the `claude` CLI, so it only runs on the
# PTY transport. Make PTY the default for chats that haven't picked one.
# CLAUDE_METHOD_DEFAULT=pty

# ── Claude ────────────────────────────────────────────────────
# Anthropic API key (optional — leave empty to use Claude Max subscription)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: explicit .env path (useful if you start the bot from another directory)
# TELECODER_ENV_PATH=/absolute/path/to/telecoder/.env

# Upgrading from Claudegram? Every TELECODER_* var below was CLAUDEGRAM_* before
# the July 2026 rename. The old names still work and log a one-time deprecation
# warning at startup, so you can rename them whenever it suits you:
#   TELECODER_ENV_PATH, TELECODER_INSTANCES_CONFIG, TELECODER_IPC_PORT,
#   TELECODER_PERMISSION_PROMPTS, TELECODER_ALLOW_NATIVE_SCHEDULING

# Path to the Claude Code CLI executable
# Default: "claude" (assumes it's in your PATH)
# CLAUDE_EXECUTABLE_PATH=/home/username/.local/bin/claude

# Use SDK bundled executable for agent queries (true/false)
# CLAUDE_USE_BUNDLED_EXECUTABLE=true

# SDK log level: off | basic | verbose | trace
# CLAUDE_SDK_LOG_LEVEL=basic

# Include partial streaming events in SDK output (true/false)
# CLAUDE_SDK_INCLUDE_PARTIAL=false

# Load user-level Claude settings (~/.claude/settings.json) into the bot's SDK
# subprocess. Default false: bot runs in an isolated env, so your interactive
# Claude Code plugins/MCP servers/hooks don't leak into the bot. Enable only if
# you know what you're doing — extra MCP tools can trigger SDK tool-deferral
# and break proactive MCP tool calls (e.g. auto-topic, send_file).
# CLAUDE_SDK_LOAD_USER_SETTINGS=false

# Extra MCP servers for the bot's agent, as a path to a JSON file holding
# {"mcpServers": {...}} in the same shape as ~/.claude.json. Merged into the
# spawn config; the bot's own claudegram-tools always wins a name clash.
#
# This is the ONLY way to add one: the spawn passes --strict-mcp-config, so a
# `claude mcp add` entry is stored and then ignored. Keep the file outside the
# repo if it carries a token.
# EXTRA_MCP_CONFIG=/home/you/.config/telecoder-mcp.json

# Marketplace plugins to enable inside the bot's agent, comma-separated, as the
# plugin@marketplace ids `claude plugin list` prints. Enabling a plugin in the
# terminal is not enough on its own: that lands in ~/.claude/settings.json,
# which neither transport reads, so the plugin's skills and commands are simply
# missing in Telegram. Naming it here is what brings it across.
# CLAUDE_PLUGINS=frontend-design@claude-plugins-official

# Append a safe reasoning summary to each response (true/false)
# CLAUDE_REASONING_SUMMARY=true

# Bot personality name used in the system prompt
# BOT_NAME=TeleCoder

# Bot run mode (used by /restartbot and /botstatus)
# BOT_MODE=prod

# ── Workspace ─────────────────────────────────────────────────
# Root directory shown in /project picker
# Default: $HOME
# WORKSPACE_DIR=/home/username/projects

# ── Response Behavior ─────────────────────────────────────────
# "streaming" = live-updating messages, "wait" = send when complete
STREAMING_MODE=streaming

# Debounce interval (ms) for streaming message edits
STREAMING_DEBOUNCE_MS=500

# Max characters per message chunk (Telegram limit is 4096)
MAX_MESSAGE_LENGTH=4096

# ── Telegraph (Instant View) ─────────────────────────────────
# When enabled, long responses (>2500 chars) are published to Telegraph
# and displayed as Instant View pages for better readability.
# When disabled, long responses are sent as multiple chunked messages.
TELEGRAPH_ENABLED=true

# ── Dangerous Mode ────────────────────────────────────────────
# Auto-approve all Claude tool permissions (use with caution!)
DANGEROUS_MODE=false

# Max iterations for /loop command
MAX_LOOP_ITERATIONS=5

# Auto-restore session on /restartbot and /rebuildbot (true/false)
# Default: false (shows manual Continue/Resume buttons instead)
AUTO_RESTORE_SESSION=false

# Allow private network URLs for /extract and /vreddit (true/false)
# Default: false (blocks localhost and RFC1918 ranges)
ALLOW_PRIVATE_NETWORK_URLS=false

# ── Reddit Integration ────────────────────────────────────────
# Native TypeScript module — no external Python dependency required
# Create a "script" app at https://www.reddit.com/prefs/apps/
#
# WARNING: Reddit's script-app OAuth requires the actual account password.
# Use a dedicated bot account — NOT your personal Reddit credentials.

# /reddit turns itself on once all four credentials below are set, and stays
# hidden otherwise. Uncomment only to force it one way or the other.
# REDDIT_ENABLED=true

# Reddit API credentials (for native TypeScript module)
# ⚠️ Use a dedicated bot account - do not use your primary Reddit account
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_PASSWORD=
REDDIT_USERNAME=

# Execution timeout (ms)
REDDITFETCH_TIMEOUT_MS=30000

# Default --limit when not specified by user
REDDITFETCH_DEFAULT_LIMIT=10

# Default comment --depth for posts
REDDITFETCH_DEFAULT_DEPTH=5
# If markdown output exceeds this many characters, auto-save JSON instead
REDDITFETCH_JSON_THRESHOLD_CHARS=8000

# Reddit video: max size for /vreddit downloads
# Enable /vreddit downloads (set false to disable)
VREDDIT_ENABLED=true

# REDDIT_VIDEO_MAX_SIZE_MB=50

# ── Medium / Freedium ─────────────────────────────────────────
# Fetches Medium articles via Freedium mirror (no Python/Playwright needed)

# Enable /medium command (set false to disable)
MEDIUM_ENABLED=true

# Freedium mirror host (default: freedium-mirror.cfd)
# FREEDIUM_HOST=freedium-mirror.cfd

# Rate limit between Freedium requests (ms)
# FREEDIUM_RATE_LIMIT_MS=2000

# ── PTY turn timeout ──────────────────────────────────────────
# Absolute per-turn wall-clock cap. The turn is killed with a
# "turn exceeded" error if it runs longer. Default 7200000 = 2 h.
# Raise it if intensive turns legitimately hit the cap.
# CLAUDE_PTY_HARD_TIMEOUT_MS=7200000

# Fetch timeout (ms)
# MEDIUM_TIMEOUT_MS=15000

# If markdown exceeds this many chars, offer to save as file
# MEDIUM_FILE_THRESHOLD_CHARS=8000

# ── Voice Transcription (Groq Whisper) ────────────────────────
# Requires: groq_transcribe.py + Groq API key
# Leave empty to disable voice message support

# Enable voice transcription + /transcribe (set false to disable)
TRANSCRIBE_ENABLED=true

# Groq API key for Whisper transcription
# GROQ_API_KEY=gsk_...

# Absolute path to groq_transcribe.py
GROQ_TRANSCRIBE_PATH=/path/to/groq_transcribe.py

# Show transcript text before agent response
VOICE_SHOW_TRANSCRIPT=true

# Max voice file size in MB (Telegram limit ~20MB)
VOICE_MAX_FILE_SIZE_MB=19

# Transcription language (ISO 639-1 code)
VOICE_LANGUAGE=en

# Transcription timeout (ms)
VOICE_TIMEOUT_MS=60000

# /transcribe: send .txt file if transcript exceeds this many characters
# TRANSCRIBE_FILE_THRESHOLD_CHARS=4000

# ── Text-to-Speech ───────────────────────────────────────────
# Toggle per-chat with /tts command

# Enable /tts voice replies (set false to disable)
TTS_ENABLED=true

# TTS provider: "groq" (Groq Orpheus, default) or "openai" (OpenAI TTS)
# Groq reuses GROQ_API_KEY above; OpenAI requires OPENAI_API_KEY below
TTS_PROVIDER=groq

# OpenAI API key (only needed when TTS_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# OpenAI TTS model (only used with TTS_PROVIDER=openai):
# gpt-4o-mini-tts (newest, supports instructions), tts-1, tts-1-hd
TTS_MODEL=gpt-4o-mini-tts

# Voice name:
#   groq voices:   autumn, diana, hannah, austin, daniel, troy
#   openai voices: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse, marin, cedar
# Default: troy (groq) or coral (openai)
TTS_VOICE=troy

# Tone instructions (gpt-4o-mini-tts only)
TTS_INSTRUCTIONS="Speak in a friendly, natural conversational tone."

# Speech speed (0.25 to 4.0)
TTS_SPEED=1.5

# Max characters to send to TTS (longer responses skip voice reply)
TTS_MAX_CHARS=4096

# Audio format: opus (recommended for Telegram voice notes), mp3, wav, flac, aac
TTS_RESPONSE_FORMAT=opus

# ── Media Extraction (/extract command) ──────────────────────────
# Extract text, audio, and video from YouTube, Instagram, and TikTok
# Requires: yt-dlp, ffmpeg, ffprobe (system binaries)

# Enable /extract command (set false to disable)
EXTRACT_ENABLED=true

# Path to a Netscape-format cookies.txt file for yt-dlp
# Needed for age-restricted / mature TikTok content, private Instagram, etc.
# Export from browser using "Get cookies.txt LOCALLY" extension
# YTDLP_COOKIES_PATH=/home/username/.claudegram/cookies.txt

# Transcription timeout per chunk (ms) — increase for very long videos
# EXTRACT_TRANSCRIBE_TIMEOUT_MS=180000

# Enable terminal-style UI by default (animated spinners, tool status)
TERMINAL_UI_DEFAULT=false

# Terminal UI verbose: show full commands, file paths, and URLs without truncation.
# Also increases session restore previews from 100/200 to 1000 chars.
# TERMINAL_UI_VERBOSE=true

# ── Message Batching ──────────────────────────────────────────
# Combine rapid-fire messages (e.g. Telegram splitting long pastes) into a
# single prompt. Set to the wait time in ms; 0 = disabled (default).
# MESSAGE_BATCH_TIMEOUT_MS=2000

# ── Agent Watchdog ────────────────────────────────────────────
# Auto-abort queries that appear stuck. Set to 0 to disable.
# Silence timeout: no messages at all from the agent (default: 180000 = 3 min)
# AGENT_SILENCE_TIMEOUT_MS=180000
# Stale tool timeout: heartbeats arrive but no meaningful progress (default: 180000 = 3 min)
# AGENT_STALE_TOOL_TIMEOUT_MS=180000

# Update the Telegram bot display name to include the active project (true/false)
# e.g. "TeleCoder | myproject" — useful when running multiple bot instances
DYNAMIC_BOT_NAME=false

# Fire a parallel Haiku side-call on every user message to derive a 1-4 word
# topic label, independent of the main agent. Deferral-immune (bypasses
# settingSources and tools entirely). Only takes effect when DYNAMIC_BOT_NAME
# is enabled and the per-chat /botname toggle is on. Auth piggybacks on the
# same Claude executable, so no extra API key is needed under Max.
AUTO_TOPIC_HAIKU=true

# Image Uploads
# Max image file size in MB (Telegram limit ~20MB for downloads)
IMAGE_MAX_FILE_SIZE_MB=20

# ── Claude Code Router (CCR) Provider ────────────────────────
# Enable /ccr and /provider toggling between Claude (Max) and CCR (true/false).
# Redirects the spawned `claude` binary through a local CCR proxy so it can
# be backed by non-Anthropic models — useful as a fallback when Max runs out.
# Requires CCR installed and running: https://github.com/musistudio/claude-code-router
# CCR_ENABLED=false

# CCR proxy base URL (where ccr's local HTTP proxy listens).
# CCR_BASE_URL=http://localhost:3456

# CCR's local auth token (see ccr config — usually any non-empty string).
# CCR_AUTH_TOKEN=

# Auto-prompt the user with an inline keyboard when a Max usage-limit
# throttle is detected. Lets them switch to CCR and retry with one tap.
# CCR_AUTO_PROMPT_ON_THROTTLE=true

# When the CCR proxy isn't reachable, automatically run `ccr start` in the
# background instead of letting the request hang on ConnectionRefused.
# CCR_AUTOSTART=false

# Path or name of the `ccr` binary used for autostart. Defaults to `ccr`
# (resolved via PATH). Override if `ccr` lives where systemd can't see it.
# CCR_BINARY=ccr
