---
// The homepage, outside Starlight: the docs pages get the sidebar and search,
// this one gets room. It reads and writes Starlight's own theme setting
// (localStorage "starlight-theme"), so a choice made here holds in the docs.
//
// The chats are mock-ups in HTML, worded as the bot really words them, until
// real screenshots and the screen recording replace them (step 3 of the plan).
const title = 'TeleCoder: Claude Code in Telegram';
const description =
  'Run Claude Code on your own machine and use it from Telegram on every device, with your Claude subscription or an API key.';
const install = 'npm install -g telecoder';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://telecoder.dev/" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://telecoder.dev/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://telecoder.dev/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('starlight-theme');
        const theme = stored === 'light' || stored === 'dark'
          ? stored
          : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="top wrap">
      <a href="/" class="brand" aria-label="TeleCoder home">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3.6 6.4 9.2 12l-5.6 5.6" class="you" />
          <path d="M11.2 6.4 16.8 12l-5.6 5.6" class="agent" />
        </svg>
        <span><span class="tele">Tele</span><span class="coder">Coder</span></span>
      </a>
      <nav aria-label="Site">
        <a href="/start/get-started/">Get started</a>
        <a href="/guides/features/">Docs</a>
        <a href="/compare/">Compare</a>
        <a href="https://github.com/gitaarik/telecoder">GitHub</a>
        <button class="theme" type="button" aria-label="Switch between light and dark">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" /></svg>
        </button>
      </nav>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="hero wrap">
        <div class="pitch">
          <h1><span class="agent-text">Claude Code</span><br />in <span class="tele">Telegram</span></h1>
          <p class="lede">Run TeleCoder on your computer or a server, and use Claude Code from Telegram on any device.</p>
          <ul class="facts">
            <li>Use your Claude subscription or an API key</li>
            <li>Work in Telegram's polished desktop and mobile apps</li>
            <li>Multitask with a bot per project and a thread per task</li>
          </ul>
          <div class="install">
            <code><span class="prompt" aria-hidden="true">$</span> {install}</code>
            <button type="button" class="copy" data-copy={install}>Copy</button>
          </div>
          <p class="actions">
            <a class="button" href="/start/get-started/">Get started</a>
            <a class="quiet" href="https://github.com/gitaarik/telecoder">View on GitHub</a>
          </p>
        </div>

        <figure class="tg hero-chat" aria-label="Example: a TeleCoder thread in Telegram">
          <div class="tg-head">
            <svg class="avatar" viewBox="0 0 24 24" aria-hidden="true">
              <rect width="24" height="24" rx="12" />
              <path d="M5.6 8 9.2 12l-3.6 4" class="you" />
              <path d="M11.6 8l3.6 4-3.6 4" class="agent" />
            </svg>
            <div><strong>webapp · Dark mode toggle</strong><span>bot</span></div>
          </div>
          <ol class="tg-body">
            <li class="msg mine" style="--i:0">Add a dark mode toggle to the settings page<time>14:02</time></li>
            <li class="msg theirs status" style="--i:1">⏳ 🔧 Editing → src/settings/Theme.tsx</li>
            <li class="msg theirs" style="--i:2">
              Done. The toggle follows the system theme until you pick one, and remembers your
              choice. All 48 tests pass.
              <span class="statusline">📁 webapp · 🧠 High · 🤖 opus · 📊 21%</span>
              <time>14:09</time>
            </li>
            <li class="msg theirs" style="--i:3">
              <b>🔐 Permission requested</b> — git push
              <code class="block">git push origin dark-mode</code>
              <span class="keys"><span class="key yes">✅ Allow once</span><span class="key">❌ Deny</span></span>
            </li>
          </ol>
        </figure>
      </section>

      <!-- How it works -->
      <section class="how wrap" aria-labelledby="how-title">
        <h2 id="how-title">How it works</h2>
        <p class="intro">Telegram already has rock-solid apps for iOS, Android, Windows, macOS and Linux. With TeleCoder you use them to talk to Claude Code running on your own computer or server.</p>
        <div class="flow">
          <div class="node">
            <svg class="logo telegram" viewBox="0 0 24 24" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm4.962 7.224c.1-.002.321.023.465.14a.5.5 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024q-.159.037-5.061 3.345-.72.495-1.302.48c-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789q.04-.324.893-.663 5.247-2.286 6.998-3.014c3.332-1.386 4.025-1.627 4.476-1.635" /></svg>
            <h3>Telegram</h3>
            <p>Send prompts and commands to your TeleCoder bot and get Claude Code's replies in your Telegram app.</p>
          </div>
          <div class="machine">
            <span class="machine-label">Your computer or server</span>
            <div class="node">
              <svg class="brandmark" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.6 6.4 9.2 12l-5.6 5.6" class="you" /><path d="M11.2 6.4 16.8 12l-5.6 5.6" class="agent" /></svg>
              <h3>TeleCoder</h3>
              <p>Forwards your messages to Claude Code and sends its replies back to Telegram, using the Bot API.</p>
            </div>
            <div class="node">
              <svg class="logo claude" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.714 15.956 4.718-2.648.079-.23-.08-.128h-.23l-.79-.048-2.695-.073-2.337-.097-2.265-.122-.57-.121-.535-.704.055-.353.48-.321.685.06 1.518.104 2.277.157 1.651.098 2.447.255h.389l.054-.158-.133-.097-.103-.098-2.356-1.596-2.55-1.688-1.336-.972-.722-.491L2 6.223l-.158-1.008.656-.722.88.06.224.061.893.686 1.906 1.476 2.49 1.833.364.304.146-.104.018-.072-.164-.274-1.354-2.446-1.445-2.49-.644-1.032-.17-.619a3 3 0 0 1-.103-.729L6.287.133 6.7 0l.995.134.42.364.619 1.415L9.735 4.14l1.555 3.03.455.898.243.832.09.255h.159V9.01l.127-1.706.237-2.095.23-2.695.08-.76.376-.91.747-.492.583.28.48.685-.067.444-.286 1.851-.558 2.903-.365 1.942h.213l.243-.242.983-1.306 1.652-2.064.728-.82.85-.904.547-.431h1.032l.759 1.129-.34 1.166-1.063 1.347-.88 1.142-1.263 1.7-.79 1.36.074.11.188-.02 2.853-.606 1.542-.28 1.84-.315.832.388.09.395-.327.807-1.967.486-2.307.462-3.436.813-.043.03.049.061 1.548.146.662.036h1.62l3.018.225.79.522.473.638-.08.485-1.213.62-1.64-.389-3.825-.91-1.31-.329h-.183v.11l1.093 1.068 2.003 1.81 2.508 2.33.127.578-.321.455-.34-.049-2.204-1.657-.85-.747-1.925-1.62h-.127v.17l.443.649 2.343 3.521.122 1.08-.17.353-.607.213-.668-.122-1.372-1.924-1.415-2.168-1.141-1.943-.14.08-.674 7.254-.316.37-.728.28-.607-.461-.322-.747.322-1.476.388-1.924.316-1.53.285-1.9.17-.632-.012-.042-.14.018-1.432 1.967-2.18 2.945-1.724 1.845-.413.164-.716-.37.066-.662.401-.589 2.386-3.036 1.439-1.882.929-1.086-.006-.158h-.055L4.138 18.56l-1.13.146-.485-.456.06-.746.231-.243 1.907-1.312Z" /></svg>
              <h3>Claude Code</h3>
              <p>The official Claude Code does the work in your project. A Pro or Max plan works, and so does an API key.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Setup -->
      <section class="setup wrap" aria-labelledby="setup-title">
        <h2 id="setup-title">Set up in three steps</h2>
        <ol class="steps">
          <li>
            <h3>Create a new bot</h3>
            <p>Send this to <a href="https://t.me/BotFather">@BotFather</a> in Telegram, and copy the token it gives you.</p>
            <pre><code>/newbot</code></pre>
          </li>
          <li>
            <h3>Install and answer a few questions</h3>
            <p>Install it with npm:</p>
            <pre><code>{install}</code></pre>
            <p>Run the setup and paste the bot token:</p>
            <pre><code>telecoder init</code></pre>
          </li>
          <li>
            <h3>Start it</h3>
            <p>Run it in your terminal:</p>
            <pre><code>telecoder start</code></pre>
            <p>Or install it as a background service:</p>
            <pre><code>telecoder service install</code></pre>
          </li>
        </ol>
        <p class="after">Then open your bot, pick a project with <code>/project</code>, and start typing. <a href="/start/get-started/">The full guide</a> takes about ten minutes.</p>
      </section>

      <!-- Examples -->
      <section class="examples wrap" aria-labelledby="examples-title">
        <h2 id="examples-title">What you can do</h2>
        <div class="tabs" role="tablist" aria-label="Examples">
          <button role="tab" id="t-threads" aria-controls="p-threads" aria-selected="true">Threads</button>
          <button role="tab" id="t-forks" aria-controls="p-forks" aria-selected="false">Forks</button>
          <button role="tab" id="t-spinoff" aria-controls="p-spinoff" aria-selected="false">Spinoffs</button>
          <button role="tab" id="t-projects" aria-controls="p-projects" aria-selected="false">Projects</button>
          <button role="tab" id="t-bots" aria-controls="p-bots" aria-selected="false">More bots</button>
          <button role="tab" id="t-output" aria-controls="p-output" aria-selected="false">Output</button>
        </div>

        <div class="panel" role="tabpanel" id="p-threads" aria-labelledby="t-threads">
          <div class="say">
            <h3>Every thread is its own session</h3>
            <p>Start a new thread for a new task. Run several side by side and switch between them like chats.</p>
            <a href="/guides/features/#threads-and-sessions">Threads and sessions</a>
          </div>
          <div class="tg">
            <ul class="threads">
              <li><b>webapp · Dark mode toggle</b><span>Done. The toggle follows the system theme…</span><time>14:09</time></li>
              <li><b>webapp · Signup emails</b><span>⏳ 💻 Running → npm test</span><time>14:11</time></li>
              <li><b>api · Rate limits</b><span>Which limit do you want for logged-out users?</span><time>13:40</time></li>
              <li><b>🍴 webapp · Dark mode toggle</b><span>Trying CSS variables instead of a theme context</span><time>12:55</time></li>
            </ul>
          </div>
        </div>

        <div class="panel" role="tabpanel" id="p-forks" aria-labelledby="t-forks">
          <div class="say">
            <h3>Fork to try another way</h3>
            <p><code>/fork</code> copies the conversation into a new thread. <code>/tree</code> shows the branches and takes you to any of them.</p>
            <a href="/guides/features/#forks">Forks</a>
          </div>
          <div class="tg">
            <ol class="tg-body">
              <li class="msg mine">/fork<time>12:51</time></li>
              <li class="msg theirs">
                <b>✅ Forked into a new thread</b><br />
                <u>🍴 webapp · Dark mode toggle</u> carries on from that point in <b>webapp</b>.
                <i>This thread carries on here unchanged.</i>
              </li>
              <li class="msg theirs">
                <b>🌳 webapp</b> — 3 branches
                <pre class="block">A dark mode toggle ·6
├B css variables ·3 ▸
└C theme context ·4 📍</pre>
                <span class="keys four"><span class="key">A</span><span class="key">B</span><span class="key">C</span></span>
              </li>
            </ol>
          </div>
        </div>

        <div class="panel" role="tabpanel" id="p-spinoff" aria-labelledby="t-spinoff">
          <div class="say">
            <h3>Split off a side task</h3>
            <p><code>/spinoff</code> starts a task in a new thread, with the context trimmed down to what it needs. Your current thread carries on.</p>
            <a href="/reference/commands/">Commands</a>
          </div>
          <div class="tg">
            <ol class="tg-body">
              <li class="msg mine">/spinoff write the database migration for the theme column<time>14:15</time></li>
              <li class="msg theirs">
                <b>🍴 Spun off into <u>🍴 webapp · Theme migration</u></b><br />
                <i>It compacts this conversation around the task, then starts on it. This thread carries on unchanged.</i>
                <span class="keys"><span class="key wide">Open 🍴 webapp · Theme migration</span></span>
              </li>
            </ol>
          </div>
        </div>

        <div class="panel" role="tabpanel" id="p-projects" aria-labelledby="t-projects">
          <div class="say">
            <h3>Switch projects with a tap</h3>
            <p><code>/project</code> opens your favourites, or browse your projects folder.</p>
            <a href="/reference/commands/#session">Session commands</a>
          </div>
          <div class="tg">
            <ol class="tg-body">
              <li class="msg theirs">
                <b>⭐ Project Favorites</b><br /><br />
                <b>Current:</b> <code>~/dev/webapp</code><br /><br />
                <i>Pick a favorite, or use the buttons below.</i>
                <span class="keys">
                  <span class="key wide">📁 webapp</span>
                  <span class="key wide">📁 api</span>
                  <span class="key wide">📁 docs-site</span>
                  <span class="key">🗂️ Browse</span><span class="key">✍️ Enter path</span>
                </span>
              </li>
            </ol>
          </div>
        </div>

        <div class="panel" role="tabpanel" id="p-bots" aria-labelledby="t-bots">
          <div class="say">
            <h3>A bot per project</h3>
            <p>Run several bots from one TeleCoder. <code>/newbot</code> makes one for a project, straight from the chat.</p>
            <a href="/guides/multiple-bots/">Multiple bots</a>
          </div>
          <div class="tg">
            <ol class="tg-body">
              <li class="msg mine">/newbot api<time>09:12</time></li>
              <li class="msg theirs">
                ✅ <u>@api_telecoder_bot</u> is set up for <b>api</b> and starts in a few seconds.
              </li>
            </ol>
          </div>
        </div>

        <div class="panel" role="tabpanel" id="p-output" aria-labelledby="t-output">
          <div class="say">
            <h3>See as much as you want</h3>
            <p>From a quiet answer to every tool call. <code>/verbosity</code>, <code>/streaming</code> and <code>/statusline</code> set how replies look.</p>
            <a href="/reference/commands/">Commands</a>
          </div>
          <div class="tg">
            <ol class="tg-body">
              <li class="msg theirs">
                <b>🎚️ Verbosity</b><br /><br />
                Current: <b>normal</b>
                <span class="keys">
                  <span class="key wide">🔇 Quiet</span>
                  <span class="key wide">✓ 💬 Normal</span>
                  <span class="key wide">🔊 Verbose</span>
                  <span class="key wide">🐛 Debug</span>
                </span>
              </li>
            </ol>
          </div>
        </div>
      </section>

      <!-- Closing -->
      <section class="end wrap">
        <h2>Try it on your next task</h2>
        <div class="install">
          <code><span class="prompt" aria-hidden="true">$</span> {install}</code>
          <button type="button" class="copy" data-copy={install}>Copy</button>
        </div>
        <p class="actions">
          <a class="button" href="/start/get-started/">Get started</a>
          <a class="quiet" href="/help/faq/">Read the FAQ</a>
        </p>
      </section>
    </main>

    <footer class="wrap">
      <p>
        Free and open source (MIT). Began as a fork of <a href="https://github.com/NachoSEO/claudegram">Claudegram</a>.
        Not affiliated with Anthropic or Telegram.
      </p>
      <p class="links">
        <a href="/compare/">Compare</a>
        <a href="/changelog/">Changelog</a>
        <a href="https://github.com/gitaarik/telecoder">GitHub</a>
        <a href="https://www.npmjs.com/package/telecoder">npm</a>
      </p>
    </footer>

    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
          button.textContent = 'Copied';
          setTimeout(() => (button.textContent = 'Copy'), 1600);
        });
      }

      document.querySelector('.theme')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('starlight-theme', next);
      });

      // Without JavaScript every example shows, one under the other.
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const select = (tab: HTMLButtonElement) => {
        for (const t of tabs) {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
        }
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab));
        tab.addEventListener('keydown', (e) => {
          const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!step) return;
          const next = tabs[(i + step + tabs.length) % tabs.length];
          select(next);
          next.focus();
        });
      });
      select(tabs[0]);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0f1319;
    --surface: #161c24;
    --raised: #1d2530;
    --line: #262f3b;
    --text: #e8e6e3;
    --muted: #939aa6;
    --agent: #e08a6b;
    --you: #5fb0f5;
    --you-bubble: #1e3a52;
    --on-agent: #1a0f0a;
    color-scheme: dark;
  }
  :root[data-theme='light'] {
    --bg: #fbfaf8;
    --surface: #f2efea;
    --raised: #ffffff;
    --line: #e2ded7;
    --text: #191c22;
    --muted: #5c6470;
    --agent: #b4502f;
    --you: #0b6fa4;
    --you-bubble: #d9ecf7;
    --on-agent: #ffffff;
    color-scheme: light;
  }

  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 400 1.0625rem/1.6 'Space Grotesk', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  code,
  pre {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.86em;
  }
  a {
    color: inherit;
  }
  :focus-visible {
    outline: 2px solid var(--you);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .wrap {
    width: min(1120px, 100% - 3rem);
    margin-inline: auto;
  }
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
  }
  .you {
    stroke: var(--you);
  }
  .agent {
    stroke: var(--agent);
  }
  .tele {
    color: var(--you);
  }
  .coder {
    color: var(--agent);
  }
  .agent-text {
    color: var(--agent);
  }
</style>

<style>
  /* Header */
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.4rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
  }
  .brand svg {
    width: 2rem;
    height: 2rem;
  }
  .brand path,
  .avatar path,
  .brandmark path {
    fill: none;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    font-size: 0.95rem;
  }
  nav a {
    white-space: nowrap;
    text-decoration: none;
    color: var(--muted);
  }
  nav a:hover {
    color: var(--text);
  }
  .theme {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .theme svg {
    width: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /* Shared pieces */
  h2 {
    margin: 0 0 2rem;
    font-size: clamp(1.8rem, 3.4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 700;
  }
