{
  "name": "telecoder",
  "version": "1.2.0",
  "description": "Claude Code from Telegram: a self-hosted bot that drives the Claude Code agent on your own machine",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "telecoder": "dist/cli.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example",
    "instances.json.example"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:multi": "tsx src/launcher.ts",
    "build": "node scripts/stamp-build.mjs && tsc",
    "prepublishOnly": "npm run typecheck && npm test && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "start": "node dist/index.js",
    "start:multi": "node dist/launcher.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "telegram",
    "claude",
    "bot",
    "ai",
    "agent"
  ],
  "author": "Rik Wanders (https://github.com/gitaarik)",
  "license": "MIT",
  "homepage": "https://telecoder.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telecoderbot/telecoder.git"
  },
  "bugs": {
    "url": "https://github.com/telecoderbot/telecoder/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@anthropic-ai/sdk": "^0.128.0",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/runner": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/headless": "^6.0.0",
    "croner": "^10.0.1",
    "dotenv": "^16.4.7",
    "grammy": "^1.46.0",
    "https-proxy-agent": "^8.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "node-pty": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  }
}
