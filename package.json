{
  "name": "telecoder",
  "version": "1.1.0",
  "description": "Claude Code from Telegram: a self-hosted bot that drives the Claude Code agent on your own machine",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:multi": "tsx src/launcher.ts",
    "build": "node scripts/stamp-build.mjs && tsc",
    "start": "node dist/index.js",
    "start:multi": "node dist/launcher.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "telegram",
    "claude",
    "bot",
    "ai",
    "agent"
  ],
  "author": "Rik Wanders (https://github.com/gitaarik)",
  "license": "MIT",
  "homepage": "https://telecoder.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitaarik/telecoder.git"
  },
  "bugs": {
    "url": "https://github.com/gitaarik/telecoder/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@anthropic-ai/sdk": "^0.128.0",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/runner": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/headless": "^6.0.0",
    "croner": "^10.0.1",
    "dotenv": "^16.4.7",
    "grammy": "^1.31.3",
    "https-proxy-agent": "^8.0.0",
    "node-pty": "^1.1.0",
    "openai": "^6.16.0",
    "telegram-markdown-v2": "^0.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.17.14",
    "@vitest/coverage-v8": "^4.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.7"
  }
}
